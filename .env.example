DATABASE_URL="file:./dev.db"

# Optional: secret required in the `Authorization: Bearer <secret>` header
# for /api/cron/update-prices. Leave unset for local dev.
CRON_SECRET=""

# Optional: CoinGecko API key (Demo or Pro). Not required for the free tier.
COINGECKO_API_KEY=""

# Optional: Bybit API credentials, only used if you wire up account-scoped
# endpoints later. The public ticker fallback needs no key.
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# Required for Stock assets: free API key from https://finnhub.io/register.
# Used for both stock quotes and company logos.
FINNHUB_API_KEY=""
