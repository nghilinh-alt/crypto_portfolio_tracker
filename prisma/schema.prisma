// Crypto Portfolio Tracker — data model
//
// Local dev uses SQLite (see .env DATABASE_URL). For deployment on Vercel,
// swap the datasource provider to "postgresql" and point DATABASE_URL at a
// hosted Postgres (e.g. Neon / Vercel Postgres) — SQLite's file is not
// persistent across serverless invocations. No other code changes needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RungStatus {
  PENDING
  TRIGGERED
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
}

enum FundSource {
  CASH_BUCKET
  EXTERNAL
}

// A tracked token. Two independent anchors drive the two ladders:
// - recentHigh drives the REBUY ladder (falls, ratchets up only, §2).
// - basePrice drives the SELL ladder (a fixed reference set once — sell
//   rungs fire as price gains % above it, which is why it can't be
//   recentHigh: recentHigh chases every new high immediately, so price can
//   never sit meaningfully above it).
// baseHoldings is the fixed quantity sell rungs size against, so cumulative
// sell % across rungs always adds up to the intended retention target
// regardless of how holdings fluctuate afterward.
model Token {
  id              String    @id @default(cuid())
  symbol          String    @unique
  name            String
  category        String? // e.g. "Core" / "Growth" / "Harvest" — informational grouping
  coingeckoId     String? // e.g. "bitcoin" — used by the CoinGecko price provider
  bybitSymbol     String? // e.g. "BTCUSDT" — used by the Bybit fallback provider
  recentHigh      Float     @default(0)
  basePrice       Float     @default(0)
  baseHoldings    Float     @default(0)
  currentPrice    Float     @default(0)
  lastPriceUpdate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sellRungs    SellRung[]
  rebuyRungs   RebuyRung[]
  transactions Transaction[]
}

// Sell ladder rung. pct is the % GAIN above basePrice that triggers this
// rung (e.g. 100 means basePrice * 2.0). sellPortionPct is the % of
// baseHoldings (fixed, not current holdings) to sell when this rung
// triggers. Trigger price is always derived from basePrice at read time —
// never stored.
model SellRung {
  id             String     @id @default(cuid())
  tokenId        String
  token          Token      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  order          Int
  pct            Float
  sellPortionPct Float
  status         RungStatus @default(PENDING)
  triggeredAt    DateTime?
  createdAt      DateTime   @default(now())

  @@unique([tokenId, order])
}

// Rebuy ladder rung. pct is the % drop from recentHigh that triggers this
// rung. deployPct is the % of Cash Bucket Contributions (gross lifetime
// inflow, §4) to deploy when this rung triggers — capped at the current
// net Cash Bucket balance at execution time (§3).
model RebuyRung {
  id          String     @id @default(cuid())
  tokenId     String
  token       Token      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  order       Int
  pct         Float
  deployPct   Float
  status      RungStatus @default(PENDING)
  triggeredAt DateTime?
  createdAt   DateTime   @default(now())

  @@unique([tokenId, order])
}

// Every BUY, SELL, DEPOSIT, and WITHDRAW is logged here. This is the single
// source of truth for both the Cash Bucket and Cash Bucket Contributions
// figures (§4) — those are always derived from this table, never stored
// separately, so they can't drift. WITHDRAW is money actually leaving the
// Cash Bucket (e.g. moved out to pay taxes) — distinct from the automatic
// tax reserve, which just earmarks part of a SELL's proceeds without any
// separate transaction.
model Transaction {
  id           String          @id @default(cuid())
  tokenId      String
  token        Token           @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  type         TransactionType
  fundedBy     FundSource? // only meaningful for BUY
  quantity     Float? // token quantity — null for DEPOSIT/WITHDRAW
  pricePerUnit Float? // USD/unit at time of tx — null for DEPOSIT/WITHDRAW
  usdAmount    Float // DEPOSIT/WITHDRAW: USD amount. BUY/SELL: quantity * pricePerUnit
  sellRungIds  String? // JSON-encoded string[] of SellRung ids this tx satisfies
  rebuyRungIds String? // JSON-encoded string[] of RebuyRung ids this tx satisfies
  note         String?
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([tokenId])
}
