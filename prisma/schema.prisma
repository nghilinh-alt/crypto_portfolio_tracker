// Crypto Portfolio Tracker — data model
//
// Local dev uses SQLite (see .env DATABASE_URL). For deployment on Vercel,
// swap the datasource provider to "postgresql" and point DATABASE_URL at a
// hosted Postgres (e.g. Neon / Vercel Postgres) — SQLite's file is not
// persistent across serverless invocations. No other code changes needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RungStatus {
  PENDING
  TRIGGERED
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
}

enum FundSource {
  CASH_BUCKET
  EXTERNAL
}

enum PortfolioCashDirection {
  IN // a token's cash bucket moved into the pool
  OUT // pool cash was assigned into a token's cash bucket
}

enum AssetType {
  CRYPTO
  STOCK
}

// A reusable sell + rebuy ladder template (e.g. "Core", "Growth",
// "Harvest") that can be applied to any token. Applying a category to a
// token COPIES both rung sets onto that token at that moment; editing the
// category afterward does not retroactively change tokens that already
// applied it.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rungs      CategorySellRung[]
  rebuyRungs CategoryRebuyRung[]
  tokens     Token[]
}

model CategorySellRung {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order          Int
  pct            Float
  sellPortionPct Float

  @@unique([categoryId, order])
}

model CategoryRebuyRung {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int
  pct        Float
  deployPct  Float

  @@unique([categoryId, order])
}

// A tracked token. Two independent anchors drive the two ladders:
// - recentHigh drives the REBUY ladder (falls, ratchets up only, §2).
// - basePrice drives the SELL ladder (a fixed reference set once — sell
//   rungs fire as price gains % above it, which is why it can't be
//   recentHigh: recentHigh chases every new high immediately, so price can
//   never sit meaningfully above it).
// baseHoldings is the fixed quantity sell rungs size against, so cumulative
// sell % across rungs always adds up to the intended retention target
// regardless of how holdings fluctuate afterward.
model Token {
  id              String    @id @default(cuid())
  symbol          String
  name            String
  assetType       AssetType @default(CRYPTO)
  categoryId      String?
  coingeckoId     String? // e.g. "bitcoin" — used by the CoinGecko price provider (CRYPTO only)
  bybitSymbol     String? // e.g. "BTCUSDT" — used by the Bybit fallback provider (CRYPTO only)
  exchange        String? // e.g. "NASDAQ" — display only, for STOCK assets
  finnhubSymbol   String? // e.g. "AAPL" — used by the Finnhub price/logo provider (STOCK only)
  iconUrl         String? // logo image URL, fetched from CoinGecko or Finnhub
  recentHigh      Float     @default(0)
  basePrice       Float     @default(0)
  basePriceSetAt  DateTime  @default(now()) // when basePrice was last (re)set — the "since" date for portfolio growth
  baseHoldings    Float     @default(0)
  currentPrice    Float     @default(0)
  // Day-range stats for the Watchlist view (a token with 0 holdings is a
  // watchlist item — no separate model needed). Populated by the same price
  // refresh as currentPrice. dayHigh/dayLow are null for CoinGecko-sourced
  // crypto — its lightweight batched endpoint doesn't return them, and
  // fetching per-coin detail for it isn't worth the added request volume.
  dayChangePct    Float?
  dayHigh         Float?
  dayLow          Float?
  lastPriceUpdate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sellRungs      SellRung[]
  rebuyRungs     RebuyRung[]
  transactions   Transaction[]
  tokenSnapshots TokenSnapshot[]
  cashMovements  PortfolioCashTransaction[]

  // Same ticker can legitimately exist as both a crypto symbol and a stock
  // ticker (e.g. UNI is both Uniswap and a NASDAQ-listed stock) — unique
  // per asset type, not globally.
  @@unique([symbol, assetType])
}

// Sell ladder rung. pct is the % GAIN above basePrice that triggers this
// rung (e.g. 100 means basePrice * 2.0). sellPortionPct is the % of
// baseHoldings (fixed, not current holdings) to sell when this rung
// triggers. Trigger price is always derived from basePrice at read time —
// never stored.
model SellRung {
  id             String     @id @default(cuid())
  tokenId        String
  token          Token      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  order          Int
  pct            Float
  sellPortionPct Float
  status         RungStatus @default(PENDING)
  triggeredAt    DateTime?
  createdAt      DateTime   @default(now())

  @@unique([tokenId, order])
}

// Rebuy ladder rung. pct is the % drop from recentHigh that triggers this
// rung. deployPct is the % of Cash Bucket Contributions (gross lifetime
// inflow, §4) to deploy when this rung triggers — capped at the current
// net Cash Bucket balance at execution time (§3).
model RebuyRung {
  id          String     @id @default(cuid())
  tokenId     String
  token       Token      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  order       Int
  pct         Float
  deployPct   Float
  status      RungStatus @default(PENDING)
  triggeredAt DateTime?
  createdAt   DateTime   @default(now())

  @@unique([tokenId, order])
}

// One row per weekly price refresh, capturing the portfolio's total value
// at that moment — the basis for the Dashboard's Portfolio Progress chart.
// Never recomputed retroactively; a point in history stays what it was.
model PortfolioSnapshot {
  id            String   @id @default(cuid())
  capturedAt    DateTime @default(now())
  totalValueUsd Float // Σ holdingsValueUsd + Σ cashBucket across all tokens, at capture time
  cashBucketUsd Float

  tokenSnapshots TokenSnapshot[]

  @@index([capturedAt])
}

// A single token's contribution to a PortfolioSnapshot, so the progress
// chart can also be filtered down to one token instead of the whole
// portfolio.
model TokenSnapshot {
  id               String            @id @default(cuid())
  snapshotId       String
  snapshot         PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  tokenId          String
  token            Token             @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  price            Float
  holdingsValueUsd Float

  @@index([tokenId])
  @@index([snapshotId])
}

// Every BUY, SELL, DEPOSIT, and WITHDRAW is logged here. This is the single
// source of truth for both the Cash Bucket and Cash Bucket Contributions
// figures (§4) — those are always derived from this table, never stored
// separately, so they can't drift. WITHDRAW is money actually leaving the
// Cash Bucket (e.g. moved out to pay taxes) — distinct from the automatic
// tax reserve, which just earmarks part of a SELL's proceeds without any
// separate transaction.
model Transaction {
  id           String          @id @default(cuid())
  tokenId      String
  token        Token           @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  type         TransactionType
  fundedBy     FundSource? // only meaningful for BUY
  quantity     Float? // token quantity — null for DEPOSIT/WITHDRAW
  pricePerUnit Float? // USD/unit at time of tx — null for DEPOSIT/WITHDRAW
  usdAmount    Float // DEPOSIT/WITHDRAW: USD amount. BUY/SELL: quantity * pricePerUnit
  sellRungIds  String? // JSON-encoded string[] of SellRung ids this tx satisfies
  rebuyRungIds String? // JSON-encoded string[] of RebuyRung ids this tx satisfies
  note         String?
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([tokenId])
}

// A portfolio-wide cash pool, separate from any token's own Cash Bucket —
// for money from a fully-exited token you're not planning to redeploy into
// that same token again. IN = a token's cash bucket moved into the pool
// (paired with a WITHDRAW Transaction on that token); OUT = pool cash
// assigned into a token's cash bucket (paired with a DEPOSIT Transaction
// on that token). Balance is always derived — Σ IN − Σ OUT — never stored.
model PortfolioCashTransaction {
  id         String                 @id @default(cuid())
  direction  PortfolioCashDirection
  amount     Float
  tokenId    String? // the token this moved from (IN) or into (OUT); null if never tied to one
  token      Token?                 @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  note       String?
  occurredAt DateTime               @default(now())
  createdAt  DateTime               @default(now())

  @@index([tokenId])
}
